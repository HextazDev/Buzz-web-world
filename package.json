{
  "name": "buzz-web-world",
  "version": "1.0.0",
  "private": true,
  "description": "Buzz! Web World — Jeu télévisé multijoueur local (Plateau TV 2.5D + Contrôleurs Smartphones)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "npm@11.0.0"
}
